// =============================================================================
// Sentinel UI-test gate — Jenkins declarative pipeline (TEMPLATE).
//
// RU: Шаблон для ВАШЕГО репозитория. Sentinel = CLI со структурными кодами выхода
//     (0/1/2/3) → ставит UI-тест в любой CI на коммит. Подробности: ci-templates/README.md.
// EN: A template for YOUR repository. Sentinel = a CLI with structured exit codes
//     (0/1/2/3) → drops a UI test into any commit-time CI. Details: ci-templates/README.en.md.
//
// Prereqs: Docker + a checkout of the Sentinel repo (or a published image once M11.1 lands),
// and a committed frozen `config/plan.json` (author it with the chat-front / `--describe`,
// then freeze the golden via `agentctl baseline update --plan plan.json`).
// =============================================================================
pipeline {
  agent any

  environment {
    // App under test (override per branch/environment).
    TARGET = 'https://staging.example.test'
    // Optional: bind ANTHROPIC_API_KEY from Jenkins credentials to enable LLM self-healing.
    // Absent key → deterministic heuristic planner + L1–L6 heal (still useful, fully offline).
    // ANTHROPIC_API_KEY = credentials('anthropic-api-key')
  }

  stages {
    stage('Build image') {
      steps {
        sh 'docker compose build sentinel'
      }
    }

    stage('Replay (UI gate)') {
      steps {
        script {
          // Replay a committed, frozen plan against the live app. `--ci` forbids bypassing the
          // plan_hash hard-abort, so a tampered/stale plan fails closed (exit 3).
          int code = sh(returnStatus: true, script: '''
            docker compose run --rm \
              -e ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}" \
              sentinel run --target "$TARGET" --replay --plan /config/plan.json --ci \
              --aut-version "${GIT_COMMIT:-unknown}"
          ''')
          echo "sentinel exit code: ${code}"
          // 0 pass · 1 the test found a problem · 2 visual/golden regression · 3 config/plan-integrity
          // · 4 OUR tool crashed · 5 OUR tool crashed but saved what it found.
          //
          // WHOSE PROBLEM IT IS decides the build result, not how bad it sounds. 1 and 2 are findings
          // ABOUT YOUR APPLICATION and fail the build. 3, 4 and 5 are not: 3 is how the run was asked
          // for, and 4/5 are Sentinel breaking. A red build there tells you to go and debug your own
          // application, which is the one thing that is certainly not the answer — so they go UNSTABLE,
          // loudly, with the reason in the log.
          //
          // ⚠ This chain used to end in `error "unexpected exit ${code}"` and knew only 0..3, so exit 4
          // and exit 5 — both shipped and both reachable — ABORTED a user's pipeline as an unexplained
          // failure. Measured 2026-08-31 (ADR-141).
          if (code == 0) {
            echo 'PASS — UI behaves as the frozen plan expects.'
          } else if (code == 1) {
            error 'FAIL: the test found a problem (exit 1) — an assertion failed / the described flow is gone.'
          } else if (code == 2) {
            error 'FAIL: visual/golden regression (exit 2) — the accessibility baseline drifted.'
          } else if (code == 3) {
            currentBuild.result = 'UNSTABLE'
            echo 'UNSTABLE: config / plan-integrity error (exit 3) — needs a human (re-baseline or fix config).'
          } else if (code == 4) {
            currentBuild.result = 'UNSTABLE'
            echo 'UNSTABLE: Sentinel itself failed (exit 4). This is OUR bug, not a finding about your ' +
                 'application — nothing was concluded about it. Please attach the run output to a bug report.'
          } else if (code == 5) {
            currentBuild.result = 'UNSTABLE'
            echo 'UNSTABLE: Sentinel itself failed (exit 5), but everything it had found was saved. ' +
                 'Still OUR bug, not a finding about your application; the artefacts say at which step ' +
                 'it stopped, and the plan/map/scenario up to that point are usable.'
          } else {
            error "FAIL: unexpected exit ${code}."
          }
        }
      }
    }
  }

  post {
    always {
      // ADR-090: build the reports before archiving. `agentctl report` is the sole producer of
      // report.html, report.json, metrics.prom and junit.xml — without this the junit step below has
      // nothing to read. In `post { always }` so a FAILED run still gets one: that is the run whose
      // report someone actually opens. `|| true` so a reporting problem never masks the real outcome.
      sh 'for d in runs/*/; do docker compose run --rm sentinel report --run "/$d" || true; done'
      // plan.json / transcript / heal-report / scenario.json / report / trace.zip land here.
      archiveArtifacts artifacts: 'runs/**', allowEmptyArchive: true
      // ADR-090: hand junit.xml to Jenkins' own test reporter. It has existed since ADR-073 as "the
      // machine contract every CI consumes", and this template consumed nothing — the results were
      // archived and invisible in the build. allowEmptyResults, because an explore run legitimately
      // produces no junit.xml (it is a replay artifact) and a missing file must not redden the build.
      junit testResults: 'runs/**/junit.xml', allowEmptyResults: true
    }
  }
}
