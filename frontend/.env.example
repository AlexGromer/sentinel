# Sentinel control-API base. The OpenAI-compat shim is at $CONTROL_API_URL/v1/chat/completions (ADR-041).
CONTROL_API_URL=http://127.0.0.1:8090
# Bearer token (CONTROL_API_TOKEN on the control-api process). Kept server-side in the Copilot Runtime.
CONTROL_API_TOKEN=
# Sentinel "model" selects the run mode: sentinel (describe) | sentinel-goal | sentinel-explore.
SENTINEL_MODEL=sentinel
