# Sentinel control-api — service configuration (conffile: your edits survive upgrades).
#
# These are the SAME CONTROL_API_* variables the container and the CLI use. There is
# no packaging-only setting: config is one model with three projections (ADR-107),
# and a deb-only knob would be a fourth.

# Where control-api finds the CLI it spawns for each run. The built-in default is
# <repo>/bin/agentctl, which only exists in a source checkout — for a packaged
# install this line is what makes runs work at all, so it ships ACTIVE.
CONTROL_API_AGENTCTL=/usr/bin/agentctl

# Bind address. Loopback by default: this service has a bearer token but no TLS,
# and publishing it beyond the host is a deployment decision, not a default.
CONTROL_API_ADDR=127.0.0.1:8090

# --- everything below is commented out: uncomment what you actually want --------------

# Serve the browser UI from this same port (ADR-064 mode 3 — one port, same-origin,
# CORS allowlist can stay empty). The startup log then prints a one-time
# ?bootstrap=<nonce> link that hands the page its token.
#CONTROL_API_SERVE_UI=1

# Manage the bearer token yourself. Unset, control-api generates one and persists it
# to the state directory (0600), reusing it across restarts.
#CONTROL_API_TOKEN=

# Print the token to the journal at startup. Off by default — the journal is readable
# by more people than the token should be.
#CONTROL_API_PRINT_TOKEN=1

# Read-only instance: refuse to mint a token at all.
#CONTROL_API_AUTOTOKEN=0

# Origins allowed to call this API from a browser (ADR-064 mode 2, split deploy).
# Leave empty when the UI is served from this same port.
#CONTROL_API_CORS_ORIGINS=

# Persistence tier (ADR-062/063): point at a store-gateway to enable GET/PUT /v1/config,
# the library views and persisted-config-driven runs.
#   systemctl enable --now sentinel-store-gateway   (no unit ships yet — run it yourself)
#CONTROL_API_STORE_ADDR=unix:/var/lib/sentinel/store.sock

# Local model endpoint for the planning/healing brain (ADR-019). Absent, runs fall back
# to the deterministic heuristic planner and L1-L6 healing.
#LLM_BACKEND=openai
#LLM_BASE_URL=http://127.0.0.1:11434/v1
#LLM_MODEL=qwen3:8b
